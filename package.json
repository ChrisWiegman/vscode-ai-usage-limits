{
  "name": "ai-usage-limits",
  "displayName": "AI Usage Limits",
  "description": "Shows Claude and Codex usage budgets in the VS Code status bar using existing extension logins",
  "version": "0.3.7",
  "publisher": "chriswiegman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisWiegman/vscode-ai-usage-limits.git"
  },
  "homepage": "https://github.com/ChrisWiegman/vscode-ai-limits#readme",
  "bugs": {
    "url": "https://github.com/ChrisWiegman/vscode-ai-usage-limits/issues"
  },
  "icon": "assets/icon.png",
  "files": [
    "assets/icon.png",
    "out/src/**/*.js",
    "README.md",
    "LICENSE.txt",
    "package.json"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "anthropic",
    "openai",
    "codex",
    "budget",
    "usage"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-limits.refresh",
        "title": "AI Limits: Refresh Now"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTests.js",
    "lint": "eslint src/ test/"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "diff": "^9.0.0",
    "serialize-javascript": "^7.0.7"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/sinon": "^22.0.0",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "changie": "^1.25.1",
    "eslint": "^10.8.0",
    "mocha": "^11.7.6",
    "sinon": "^22.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
